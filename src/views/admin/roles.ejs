<%- include('../partials/head') %>
<main class="container">
  <a href="/admin/dashboard">← Back</a>
  <h1>Admin Role Overview</h1>
  <section class="card">
    <table>
      <thead><tr><th>Username</th><th>Name</th><th>Role</th><th>Status</th></tr></thead>
      <tbody>
        <% admins.forEach((a) => { %>
          <tr>
            <td><%= a.username %></td>
            <td><%= a.fullName %></td>
            <td><%= a.role %></td>
            <td><%= a.isActive ? 'ACTIVE' : 'DISABLED' %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </section>
</main>
<%- include('../partials/footer') %>
